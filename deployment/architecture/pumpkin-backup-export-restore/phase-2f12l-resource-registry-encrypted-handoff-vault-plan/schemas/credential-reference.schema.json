{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pumpkincms.local/schemas/credential-reference.schema.json",
  "title": "Pumpkin Credential Reference",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "credentialRefId",
    "displayName",
    "purpose",
    "requiredFor",
    "resourceIds",
    "tenantKeys",
    "environment",
    "owner",
    "storageLocationCategory",
    "escrowEligible",
    "escrowStatus",
    "rotationRequired",
    "cleanupRequiredAfterBuild",
    "valueIncluded"
  ],
  "properties": {
    "credentialRefId": {
      "type": "string",
      "minLength": 1
    },
    "displayName": {
      "type": "string"
    },
    "purpose": {
      "type": "string"
    },
    "requiredFor": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "resourceIds": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tenantKeys": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "environment": {
      "enum": [
        "local",
        "dev",
        "staging",
        "production"
      ]
    },
    "owner": {
      "type": "string"
    },
    "storageLocationCategory": {
      "enum": [
        "managed-identity",
        "platform-secret-store",
        "operator-local-vault",
        "encrypted-handoff-vault",
        "not-collected",
        "not-required"
      ]
    },
    "escrowEligible": {
      "type": "boolean"
    },
    "escrowStatus": {
      "enum": [
        "not-collected",
        "not-approved",
        "approved-for-future-vault",
        "included-in-encrypted-vault",
        "not-eligible"
      ]
    },
    "rotationRequired": {
      "type": "boolean"
    },
    "rotationCadence": {
      "type": [
        "string",
        "null"
      ]
    },
    "lastVerifiedAt": {
      "type": [
        "string",
        "null"
      ]
    },
    "cleanupRequiredAfterBuild": {
      "type": "boolean"
    },
    "nonEscrowReason": {
      "type": [
        "string",
        "null"
      ]
    },
    "valueIncluded": {
      "const": false
    }
  }
}

