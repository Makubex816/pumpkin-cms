{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pumpkincms.local/schemas/multi-tenant-onboarding/support-packet.schema.json",
  "title": "Pumpkin CMS Support Packet",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "tenantId", "siteKey", "issueSummary", "currentGate", "publicUrls", "validationReports", "ownerContacts", "redaction"],
  "properties": {
    "schemaVersion": { "type": "string", "pattern": "^1\\.0\\.0$" },
    "tenantId": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$" },
    "siteKey": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$" },
    "issueSummary": { "type": "string", "minLength": 5 },
    "currentGate": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,80}$" },
    "publicUrls": { "type": "array", "items": { "type": "string", "format": "uri" } },
    "validationReports": { "type": "array", "items": { "type": "string" } },
    "ownerContacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "contactMethod"],
        "properties": {
          "role": { "type": "string" },
          "contactMethod": { "type": "string" }
        }
      }
    },
    "redaction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["secretsIncluded", "protectedConfigIncluded", "mailboxContentsIncluded"],
      "properties": {
        "secretsIncluded": { "type": "boolean", "const": false },
        "protectedConfigIncluded": { "type": "boolean", "const": false },
        "mailboxContentsIncluded": { "type": "boolean", "const": false }
      }
    }
  }
}
