{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pumpkincms.local/schemas/multi-tenant-onboarding/seo.schema.json",
  "title": "Pumpkin CMS SEO",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "tenantId", "siteKey", "defaultRobots", "canonicalBaseUrl", "sitemapPolicy"],
  "properties": {
    "schemaVersion": { "type": "string", "pattern": "^1\\.0\\.0$" },
    "tenantId": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$" },
    "siteKey": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$" },
    "defaultRobots": { "type": "string", "enum": ["index,follow", "noindex,nofollow"] },
    "canonicalBaseUrl": { "type": "string", "format": "uri" },
    "sitemapPolicy": { "type": "string", "enum": ["approved-routes-only", "disabled-until-final-gate"] },
    "indexingFinalGate": { "type": "boolean", "const": true }
  }
}

