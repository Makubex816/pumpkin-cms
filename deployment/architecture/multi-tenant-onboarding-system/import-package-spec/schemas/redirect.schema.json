{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pumpkincms.local/schemas/multi-tenant-onboarding/redirect.schema.json",
  "title": "Pumpkin CMS Redirects",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "tenantId", "siteKey", "redirects"],
  "properties": {
    "schemaVersion": { "type": "string", "pattern": "^1\\.0\\.0$" },
    "tenantId": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$" },
    "siteKey": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$" },
    "redirects": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source", "destination", "statusCode", "reason"],
        "properties": {
          "source": { "type": "string", "pattern": "^/.+" },
          "destination": { "type": "string", "minLength": 1 },
          "statusCode": { "type": "integer", "enum": [301, 302, 307, 308] },
          "reason": { "type": "string", "minLength": 3 }
        }
      }
    }
  }
}
