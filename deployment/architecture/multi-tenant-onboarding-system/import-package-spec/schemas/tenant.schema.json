{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pumpkincms.local/schemas/multi-tenant-onboarding/tenant.schema.json",
  "title": "Pumpkin CMS Tenant",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "tenantId", "siteKey", "displayName", "businessType", "cmsTenantSlug", "status"],
  "properties": {
    "schemaVersion": { "type": "string", "pattern": "^1\\.0\\.0$" },
    "tenantId": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$" },
    "siteKey": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$" },
    "displayName": { "type": "string", "minLength": 2, "maxLength": 120 },
    "businessType": { "type": "string", "minLength": 2, "maxLength": 120 },
    "cmsTenantSlug": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$" },
    "status": { "type": "string", "enum": ["intake-draft", "import-package-valid", "cms-preview-ready", "paused"] },
    "tenantApiKeyPlaceholder": { "type": "string", "const": "TENANT_API_KEY_RUNTIME_ONLY" },
    "relatedTenants": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "pausedRelatedTenants": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "owners": { "type": "array", "items": { "type": "object" } },
    "notes": { "type": "string" }
  },
  "examples": [
    {
      "schemaVersion": "1.0.0",
      "tenantId": "example-rink-rentals",
      "siteKey": "example-rink-rentals",
      "displayName": "Example Rink Rentals",
      "businessType": "event rentals",
      "cmsTenantSlug": "example-rink-rentals",
      "status": "intake-draft",
      "tenantApiKeyPlaceholder": "TENANT_API_KEY_RUNTIME_ONLY"
    }
  ]
}
