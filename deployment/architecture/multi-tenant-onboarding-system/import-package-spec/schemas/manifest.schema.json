{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pumpkincms.local/schemas/multi-tenant-onboarding/manifest.schema.json",
  "title": "Pumpkin CMS Import Package Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "packageVersion", "tenantId", "siteKey", "createdFor", "files", "validation"],
  "properties": {
    "schemaVersion": { "type": "string", "pattern": "^1\\.0\\.0$" },
    "packageVersion": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "tenantId": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$" },
    "siteKey": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$" },
    "createdFor": { "type": "string", "minLength": 2 },
    "files": { "type": "array", "items": { "type": "string" }, "minItems": 1, "uniqueItems": true },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "externalMutationAllowed"],
      "properties": {
        "status": { "type": "string", "enum": ["not-run", "pass", "fail"] },
        "externalMutationAllowed": { "type": "boolean", "const": false }
      }
    }
  }
}
