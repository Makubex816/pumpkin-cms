{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pumpkincms.local/schemas/multi-tenant-onboarding/owner-contact.schema.json",
  "title": "Pumpkin CMS Owner Contacts",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "tenantId", "siteKey", "contacts"],
  "properties": {
    "schemaVersion": { "type": "string", "pattern": "^1\\.0\\.0$" },
    "tenantId": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$" },
    "siteKey": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$" },
    "contacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "name", "contactMethod", "responsibility", "backupStatus"],
        "properties": {
          "role": {
            "type": "string",
            "enum": ["business-owner", "content-owner", "legal-privacy-reviewer", "form-inbox-owner", "dns-owner", "hosting-owner", "cloudflare-owner", "azure-owner", "rollback-owner", "indexing-owner", "operator", "developer"]
          },
          "name": { "type": "string", "minLength": 2 },
          "contactMethod": { "type": "string", "minLength": 3 },
          "responsibility": { "type": "string", "minLength": 8 },
          "backupStatus": { "type": "string", "enum": ["backup-assigned", "backup-needed", "not-required"] }
        }
      }
    }
  }
}
