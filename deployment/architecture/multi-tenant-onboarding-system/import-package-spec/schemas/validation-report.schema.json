{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pumpkincms.local/schemas/multi-tenant-onboarding/validation-report.schema.json",
  "title": "Pumpkin CMS Validation Report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "tenantId", "siteKey", "gate", "status", "externalMutationPerformed", "findings", "nextActions", "boundaryConfirmation"],
  "properties": {
    "schemaVersion": { "type": "string", "pattern": "^1\\.0\\.0$" },
    "tenantId": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$" },
    "siteKey": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$" },
    "gate": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,80}$" },
    "status": { "type": "string", "enum": ["not-run", "pass", "warning", "fail", "blocked"] },
    "externalMutationPerformed": { "type": "boolean" },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["severity", "code", "message", "blocksGate"],
        "properties": {
          "severity": { "type": "string", "enum": ["info", "warning", "error", "critical"] },
          "code": { "type": "string", "pattern": "^[A-Z0-9_]{3,80}$" },
          "file": { "type": "string" },
          "route": { "type": "string" },
          "message": { "type": "string", "minLength": 5 },
          "operatorDetail": { "type": "string" },
          "blocksGate": { "type": "boolean" }
        }
      }
    },
    "nextActions": { "type": "array", "items": { "type": "string" } },
    "boundaryConfirmation": {
      "type": "object",
      "additionalProperties": { "type": "boolean" }
    }
  }
}
