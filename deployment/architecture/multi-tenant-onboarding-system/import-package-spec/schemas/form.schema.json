{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pumpkincms.local/schemas/multi-tenant-onboarding/form.schema.json",
  "title": "Pumpkin CMS Forms",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "tenantId", "siteKey", "forms"],
  "properties": {
    "schemaVersion": { "type": "string", "pattern": "^1\\.0\\.0$" },
    "tenantId": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$" },
    "siteKey": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$" },
    "forms": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["formId", "displayName", "deliveryMode", "recipient", "mailboxOwner", "fields", "consentNoticeStatus", "rollbackMode"],
        "properties": {
          "formId": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,80}$" },
          "displayName": { "type": "string" },
          "deliveryMode": { "type": "string", "enum": ["no-email", "graph", "webhook", "profile-managed"] },
          "recipient": { "type": "string", "format": "email" },
          "mailboxOwner": { "type": "string" },
          "fields": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
          "consentNoticeStatus": { "type": "string", "enum": ["approved", "pending-review", "not-required-by-owner"] },
          "rollbackMode": { "type": "string", "enum": ["no-email", "disable-form", "profile-managed"] }
        }
      }
    }
  }
}

