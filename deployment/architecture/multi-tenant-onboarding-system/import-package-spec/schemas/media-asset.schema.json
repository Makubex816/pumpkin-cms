{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pumpkincms.local/schemas/multi-tenant-onboarding/media-asset.schema.json",
  "title": "Pumpkin CMS Media Assets",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "tenantId", "siteKey", "assets"],
  "properties": {
    "schemaVersion": { "type": "string", "pattern": "^1\\.0\\.0$" },
    "tenantId": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$" },
    "siteKey": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$" },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["mediaId", "fileName", "kind", "altText", "sourceStatus", "publicUrl"],
        "properties": {
          "mediaId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,120}$" },
          "fileName": { "type": "string", "minLength": 3 },
          "kind": { "type": "string", "enum": ["logo", "image", "icon", "document"] },
          "altText": { "type": "string", "minLength": 2 },
          "sourceStatus": { "type": "string", "enum": ["usage-rights-confirmed", "pending-review", "placeholder"] },
          "publicUrl": { "type": "string", "format": "uri", "description": "Must not be localhost, local /media path, SAS URL, or protected path." }
        }
      }
    }
  }
}
