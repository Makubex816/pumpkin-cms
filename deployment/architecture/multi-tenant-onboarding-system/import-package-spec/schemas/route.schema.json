{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pumpkincms.local/schemas/multi-tenant-onboarding/route.schema.json",
  "title": "Pumpkin CMS Routes",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "tenantId", "siteKey", "approvedRoutes", "forbiddenRoutes"],
  "properties": {
    "schemaVersion": { "type": "string", "pattern": "^1\\.0\\.0$" },
    "tenantId": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$" },
    "siteKey": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$" },
    "approvedRoutes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^/$|^/[a-z0-9][a-z0-9-]*(/[a-z0-9][a-z0-9-]*)*/$" }
    },
    "forbiddenRoutes": {
      "type": "array",
      "items": { "type": "string", "pattern": "^/.+" },
      "uniqueItems": true
    },
    "wwwBehavior": { "type": "string", "enum": ["canonical-only", "redirect-to-primary", "primary-host"] },
    "notes": { "type": "string" }
  },
  "examples": [
    {
      "schemaVersion": "1.0.0",
      "tenantId": "example-rink-rentals",
      "siteKey": "example-rink-rentals",
      "approvedRoutes": ["/", "/contact/", "/service-areas/"],
      "forbiddenRoutes": ["/draft/", "/preview/"],
      "wwwBehavior": "canonical-only"
    }
  ]
}

