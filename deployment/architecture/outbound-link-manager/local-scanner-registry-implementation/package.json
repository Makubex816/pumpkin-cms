{
  "name": "pumpkin-outbound-link-manager-local-scanner",
  "version": "0.10.0",
  "private": true,
  "type": "module",
  "description": "Local/offline fixture-only outbound link scanner and registry foundation for Pumpkin CMS.",
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "check": "node scripts/check-all.mjs && npm test",
    "scan:single": "node src/outbound-link-cli.mjs scan --fixture fixtures/single-link.fixture.json --out .tmp/single-link-scan --overwrite",
    "scan:tenant-bundle": "node src/outbound-link-cli.mjs scan --fixture fixtures/tenant-bundle.fixture.json --out .tmp/tenant-bundle-scan --overwrite",
    "validate:tenant-bundle": "node src/outbound-link-cli.mjs validate --scan .tmp/tenant-bundle-scan",
    "inspect:tenant-bundle": "node src/outbound-link-cli.mjs inspect --scan .tmp/tenant-bundle-scan",
    "store:init": "node src/outbound-link-cli.mjs init-store --tenant fixture-tenant --site fixture-site --out .tmp/local-store --overwrite",
    "store:merge": "node src/outbound-link-cli.mjs merge-scan --store .tmp/local-store --scan .tmp/tenant-bundle-scan --out .tmp/local-store-merged --overwrite",
    "store:validate": "node src/outbound-link-cli.mjs validate-store --store .tmp/local-store-merged",
    "store:inspect": "node src/outbound-link-cli.mjs inspect-store --store .tmp/local-store-merged",
    "render:active": "node src/outbound-link-cli.mjs render-fixture --fixture fixtures/render-active-links.fixture.json --store .tmp/local-store-merged --out .tmp/render-active --overwrite",
    "render:validate": "node src/outbound-link-cli.mjs validate-render --rendered .tmp/render-active",
    "integration:backup": "node src/outbound-link-cli.mjs export-backup --store .tmp/local-store-merged --rendered .tmp/render-active --out .tmp/backup-center-export --overwrite",
    "integration:tenant-bundle": "node src/outbound-link-cli.mjs export-tenant-bundle --store .tmp/local-store-merged --rendered .tmp/render-active --out .tmp/tenant-bundle-export --overwrite"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@azure/cosmos": "^4.9.3",
    "@azure/identity": "^4.13.1"
  }
}
