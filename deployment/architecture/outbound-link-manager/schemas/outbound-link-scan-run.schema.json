{
  "$schema": "https://json-schema.org/draft-07/schema",
  "$id": "https://pumpkincms.local/schemas/outbound-link-scan-run.schema.json",
  "title": "Outbound Link Scan Run",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "tenant_id",
    "site_id",
    "mode",
    "status",
    "started_at",
    "pages_scanned",
    "links_found",
    "new_links_found",
    "stale_instances_found",
    "errors"
  ],
  "properties": {
    "schemaVersion": { "type": "string", "const": "0.1.0" },
    "id": { "type": "string", "minLength": 1 },
    "tenant_id": { "type": "string", "minLength": 1 },
    "site_id": { "type": "string", "minLength": 1 },
    "mode": {
      "type": "string",
      "enum": [
        "local-fixture",
        "tenant-bundle",
        "import-package",
        "backup-bundle",
        "live-readonly-cms-snapshot"
      ]
    },
    "status": {
      "type": "string",
      "enum": ["planned", "running", "completed", "failed", "blocked"]
    },
    "started_at": { "type": "string", "format": "date-time" },
    "completed_at": { "type": ["string", "null"], "format": "date-time" },
    "pages_scanned": { "type": "integer", "minimum": 0 },
    "links_found": { "type": "integer", "minimum": 0 },
    "new_links_found": { "type": "integer", "minimum": 0 },
    "stale_instances_found": { "type": "integer", "minimum": 0 },
    "errors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "message"],
        "properties": {
          "code": { "type": "string" },
          "message": { "type": "string" },
          "path": { "type": ["string", "null"] }
        }
      }
    }
  }
}
