{
  "$schema": "https://json-schema.org/draft-07/schema",
  "$id": "https://pumpkincms.local/schemas/outbound-link.schema.json",
  "title": "Outbound Link",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "tenant_id",
    "site_id",
    "original_url",
    "normalized_url",
    "domain",
    "status",
    "created_at",
    "updated_at",
    "created_by"
  ],
  "properties": {
    "schemaVersion": { "type": "string", "const": "0.1.0" },
    "id": { "type": "string", "minLength": 1 },
    "tenant_id": { "type": "string", "minLength": 1 },
    "site_id": { "type": "string", "minLength": 1 },
    "original_url": { "type": "string", "format": "uri" },
    "normalized_url": { "type": "string", "format": "uri" },
    "domain": { "type": "string", "minLength": 1 },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "disabled",
        "pending_review",
        "domain_blocked",
        "stale",
        "broken_unverified",
        "archived"
      ]
    },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" },
    "created_by": { "type": "string", "minLength": 1 },
    "disabled_by": { "type": ["string", "null"] },
    "disabled_at": { "type": ["string", "null"], "format": "date-time" },
    "disabled_reason": { "type": ["string", "null"] }
  }
}
