{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Pumpkin documentation package manifest v3",
  "type": "object",
  "required": [
    "package",
    "version",
    "generatedAt",
    "status",
    "sourceState",
    "fileCount",
    "files"
  ],
  "properties": {
    "package": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "const": "3.0.0"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string"
    },
    "sourceState": {
      "type": "object",
      "required": [
        "upstreamCandidate",
        "publicDownstreamHead",
        "activeBuild"
      ]
    },
    "fileCount": {
      "type": "integer",
      "minimum": 1
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "path",
          "sha256",
          "bytes"
        ]
      }
    }
  },
  "additionalProperties": true
}
