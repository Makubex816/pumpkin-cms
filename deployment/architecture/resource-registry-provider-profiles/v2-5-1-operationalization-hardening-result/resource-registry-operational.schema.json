      "type": "string",
      "minLength": 1
    },
    "environmentModeMatrix": {
      "type": "array"
    },
    "providerProfiles": {
      "type": "array"
    },
    "resourceBindings": {
      "type": "array"
    },
    "evidenceRefs": {
      "type": "array"
    }
  },
  "additionalProperties": true
