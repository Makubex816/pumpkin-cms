{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pumpkincms.local/schemas/media-manifest.schema.json",
  "title": "Tenant Media Manifest",
  "type": "object",
  "required": ["tenantId", "assets"],
  "properties": {
    "tenantId": { "type": "string" },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "fileRef"],
        "properties": {
          "id": { "type": "string" },
          "fileRef": { "type": "string" },
          "alt": { "type": "string" },
          "status": { "type": "string" }
        }
      }
    }
  },
  "additionalProperties": true
}
