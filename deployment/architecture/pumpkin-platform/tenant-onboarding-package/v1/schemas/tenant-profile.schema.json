{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pumpkincms.local/schemas/tenant-profile.schema.json",
  "title": "Tenant Profile",
  "type": "object",
  "required": ["tenantId", "displayName", "status"],
  "properties": {
    "tenantId": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "displayName": { "type": "string", "minLength": 1 },
    "status": { "enum": ["draft", "active", "paused"] },
    "owner": { "type": "object" },
    "notes": { "type": "string" }
  },
  "additionalProperties": true
}
