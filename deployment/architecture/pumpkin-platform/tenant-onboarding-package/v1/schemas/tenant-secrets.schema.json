{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pumpkincms.local/schemas/tenant-secrets.schema.json",
  "title": "Pumpkin Tenant Secure Handoff",
  "type": "object",
  "required": ["tenantId", "schemaVersion", "secretSources"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "tenantId": { "type": "string" },
    "secretSources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "source"],
        "properties": {
          "name": { "type": "string" },
          "source": { "type": "string" },
          "required": { "type": "boolean" }
        }
      }
    }
  },
  "additionalProperties": true
}
