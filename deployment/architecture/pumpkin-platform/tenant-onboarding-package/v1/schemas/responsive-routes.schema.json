{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pumpkincms.local/schemas/responsive-routes.schema.json",
  "title": "Tenant Responsive Route Matrix",
  "type": "object",
  "required": ["tenantId", "viewports", "routes", "checks"],
  "properties": {
    "tenantId": { "type": "string" },
    "standard": { "const": "v2.8.60v-mobile-responsive" },
    "viewports": {
      "type": "array",
      "minItems": 7,
      "items": {
        "type": "object",
        "required": ["label", "width", "height"],
        "properties": {
          "label": { "type": "string" },
          "width": { "type": "integer", "minimum": 320 },
          "height": { "type": "integer", "minimum": 600 }
        },
        "additionalProperties": true
      }
    },
    "routes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "purpose"],
        "properties": {
          "path": { "type": "string", "pattern": "^/" },
          "purpose": { "type": "string" },
          "critical": { "type": "boolean" },
          "source": { "type": "string" }
        },
        "additionalProperties": true
      }
    },
    "checks": {
      "type": "object",
      "required": ["horizontalOverflow", "consoleErrors", "failedRequests", "missingImages", "formsNoSubmit"],
      "properties": {
        "horizontalOverflow": { "const": true },
        "consoleErrors": { "enum": ["zero", "documented"] },
        "failedRequests": { "enum": ["zero", "documented"] },
        "missingImages": { "const": "zero" },
        "formsNoSubmit": { "const": true }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
