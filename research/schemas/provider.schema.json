{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pumpkin-cms.local/research/schemas/provider.schema.json",
  "title": "Pumpkin Provider Research Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaType",
    "recordStatus",
    "providerId",
    "companyName",
    "website",
    "phone",
    "email",
    "headquartersCity",
    "headquartersState",
    "locations",
    "serviceStates",
    "serviceCities",
    "evidenceUrls",
    "evidenceNotes",
    "offersPortableIceRinkRentals",
    "offersPortableRollerRinkRentals",
    "partyRentalIndustryFit",
    "commercialEventFit",
    "municipalityFit",
    "schoolEventFit",
    "corporateEventFit",
    "ratingSignals",
    "reviewSignals",
    "contactClarity",
    "confidence",
    "scoreBreakdown",
    "totalScore",
    "routingFit",
    "notes",
    "lastReviewed"
  ],
  "properties": {
    "schemaType": { "type": "string", "const": "provider" },
    "recordStatus": {
      "type": "string",
      "enum": ["template", "example", "draft", "researched", "approved", "verified"]
    },
    "providerId": { "type": "string", "minLength": 1 },
    "companyName": { "type": "string", "minLength": 1 },
    "website": { "type": "string" },
    "phone": { "type": "string" },
    "email": { "type": "string" },
    "headquartersCity": { "type": "string" },
    "headquartersState": { "type": "string" },
    "locations": { "type": "array", "items": { "type": "string" } },
    "serviceStates": { "type": "array", "items": { "type": "string" } },
    "serviceCities": { "type": "array", "items": { "type": "string" } },
    "evidenceUrls": { "type": "array", "items": { "type": "string" } },
    "evidenceNotes": { "type": "string" },
    "offersPortableIceRinkRentals": { "type": "boolean" },
    "offersPortableRollerRinkRentals": { "type": "boolean" },
    "partyRentalIndustryFit": { "type": "boolean" },
    "commercialEventFit": { "type": "boolean" },
    "municipalityFit": { "type": "boolean" },
    "schoolEventFit": { "type": "boolean" },
    "corporateEventFit": { "type": "boolean" },
    "ratingSignals": { "type": "string" },
    "reviewSignals": { "type": "string" },
    "contactClarity": { "type": "string" },
    "confidence": { "type": "string", "enum": ["unknown", "low", "medium", "high", "verified"] },
    "scoreBreakdown": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "portableRinkService",
        "stateRegionService",
        "nearbyLocationPresence",
        "eventRentalRelevance",
        "websiteClarityProof",
        "commercialEventCapacity",
        "responseContactQuality",
        "reviewReputationSignals",
        "leadRoutingFit"
      ],
      "properties": {
        "portableRinkService": { "type": "number", "minimum": 0, "maximum": 5 },
        "stateRegionService": { "type": "number", "minimum": 0, "maximum": 5 },
        "nearbyLocationPresence": { "type": "number", "minimum": 0, "maximum": 4 },
        "eventRentalRelevance": { "type": "number", "minimum": 0, "maximum": 4 },
        "websiteClarityProof": { "type": "number", "minimum": 0, "maximum": 4 },
        "commercialEventCapacity": { "type": "number", "minimum": 0, "maximum": 4 },
        "responseContactQuality": { "type": "number", "minimum": 0, "maximum": 3 },
        "reviewReputationSignals": { "type": "number", "minimum": 0, "maximum": 3 },
        "leadRoutingFit": { "type": "number", "minimum": 0, "maximum": 3 }
      }
    },
    "totalScore": { "type": "number", "minimum": 0, "maximum": 35 },
    "routingFit": {
      "type": "string",
      "enum": ["unknown", "do_not_route", "weak_fit", "possible_fit", "good_fit", "preferred_fit"]
    },
    "notes": { "type": "string" },
    "lastReviewed": { "type": "string" }
  }
}
