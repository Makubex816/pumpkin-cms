{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pumpkin-cms.local/research/schemas/partner.schema.json",
  "title": "Pumpkin Partner Service Matrix",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaType",
    "recordStatus",
    "partnerId",
    "partnerName",
    "partnerType",
    "website",
    "publicNameAllowed",
    "logoUseAllowed",
    "photoUseAllowed",
    "confirmedServices",
    "confirmedStates",
    "confirmedCities",
    "extendedStatesPossible",
    "extendedCitiesPossible",
    "requiresManualReviewOutsideCoreArea",
    "maxDeliveryRadiusMiles",
    "minimumEventSizeNotes",
    "inventory",
    "setupRequirements",
    "insurance",
    "leadRouting",
    "notes",
    "lastReviewed"
  ],
  "properties": {
    "schemaType": { "type": "string", "const": "partner" },
    "recordStatus": {
      "type": "string",
      "enum": ["template", "example", "draft", "researched", "approved", "verified"]
    },
    "partnerId": { "type": "string", "minLength": 1 },
    "partnerName": { "type": "string", "minLength": 1 },
    "partnerType": {
      "type": "string",
      "enum": [
        "primary_party_rental_partner",
        "fulfillment_partner",
        "referral_partner",
        "research_placeholder",
        "other"
      ]
    },
    "website": { "type": "string" },
    "publicNameAllowed": { "type": "boolean" },
    "logoUseAllowed": { "type": "boolean" },
    "photoUseAllowed": { "type": "boolean" },
    "confirmedServices": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["syntheticIceRink", "realIceRink", "portableRollerRink"]
      }
    },
    "confirmedStates": { "type": "array", "items": { "type": "string" } },
    "confirmedCities": { "type": "array", "items": { "type": "string" } },
    "extendedStatesPossible": { "type": "array", "items": { "type": "string" } },
    "extendedCitiesPossible": { "type": "array", "items": { "type": "string" } },
    "requiresManualReviewOutsideCoreArea": { "type": "boolean" },
    "maxDeliveryRadiusMiles": { "type": ["number", "null"], "minimum": 0 },
    "minimumEventSizeNotes": { "type": "string" },
    "inventory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "syntheticIceRink",
        "realIceRink",
        "portableRollerRink",
        "rinkSizes",
        "skatesAvailable",
        "staffAvailable",
        "barriersAvailable",
        "lightingAvailable",
        "brandingAvailable"
      ],
      "properties": {
        "syntheticIceRink": { "type": "boolean" },
        "realIceRink": { "type": "boolean" },
        "portableRollerRink": { "type": "boolean" },
        "rinkSizes": { "type": "array", "items": { "type": "string" } },
        "skatesAvailable": { "type": "boolean" },
        "staffAvailable": { "type": "boolean" },
        "barriersAvailable": { "type": "boolean" },
        "lightingAvailable": { "type": "boolean" },
        "brandingAvailable": { "type": "boolean" }
      }
    },
    "setupRequirements": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "indoor",
        "outdoor",
        "flatSurfaceRequired",
        "grassAllowed",
        "pavementAllowed",
        "powerRequired",
        "accessRequirements"
      ],
      "properties": {
        "indoor": { "type": "boolean" },
        "outdoor": { "type": "boolean" },
        "flatSurfaceRequired": { "type": "boolean" },
        "grassAllowed": { "type": "boolean" },
        "pavementAllowed": { "type": "boolean" },
        "powerRequired": { "type": "boolean" },
        "accessRequirements": { "type": "string" }
      }
    },
    "insurance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["coiAvailable", "municipalEventSupport"],
      "properties": {
        "coiAvailable": { "type": "boolean" },
        "municipalEventSupport": { "type": "boolean" }
      }
    },
    "leadRouting": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "routeDirectlyIfCoreArea",
        "manualReviewIfOutsideArea",
        "preferredContactMethod",
        "responseExpectation"
      ],
      "properties": {
        "routeDirectlyIfCoreArea": { "type": "boolean" },
        "manualReviewIfOutsideArea": { "type": "boolean" },
        "preferredContactMethod": {
          "type": "string",
          "enum": ["manual_review", "email", "phone", "crm", "webhook", "not_set"]
        },
        "responseExpectation": { "type": "string" }
      }
    },
    "notes": { "type": "string" },
    "lastReviewed": { "type": "string" }
  }
}
