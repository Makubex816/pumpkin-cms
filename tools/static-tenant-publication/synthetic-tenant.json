{
  "artifactId": "synthetic-pumpkin-swa-static-artifact",
  "tenantUid": "tenant_synth_static_0001",
  "publicationId": "publication-synth-static-0001",
  "releaseId": "release_synth_static_0001_v1",
  "publicMode": "preview-no-post",
  "indexingState": {
    "mode": "disabled",
    "robots": "noindex,nofollow,noarchive",
    "includeInSitemap": false
  },
  "displayName": "Synthetic Static Pumpkin",
  "apiBaseUrl": "https://api.synthetic.example.invalid",
  "theme": {
    "id": "pumpkin-evergreen",
    "version": "pub20-a02",
    "css": ":root{--pumpkin-accent:#f97316;--pumpkin-bg:#fff7ed;--pumpkin-ink:#1f1308}body{margin:0;font-family:Inter,system-ui,sans-serif;background:var(--pumpkin-bg);color:var(--pumpkin-ink)}main{max-width:72rem;margin:0 auto;padding:3rem 1.25rem}.hero{border:1px solid #fed7aa;border-radius:1.5rem;padding:2rem;background:#fff}.card{border:1px solid #ffedd5;border-radius:1rem;padding:1rem;background:#fff}a{color:#c2410c}.form{display:grid;gap:.75rem}.field{display:grid;gap:.25rem}.pumpkin-consent{font-size:.95rem}"
  },
  "routes": [
    {
      "path": "/",
      "title": "Synthetic Static Pumpkin",
      "blocks": [
        {
          "type": "hero",
          "heading": "A deterministic static tenant preview",
          "body": "Generated from shared Pumpkin source and synthetic non-customer configuration."
        },
        {
          "type": "card",
          "heading": "Static at rest",
          "body": "The public files contain no reusable provider credentials and no customer payloads."
        }
      ]
    },
    {
      "path": "/contact",
      "title": "Contact the synthetic tenant",
      "formId": "synthetic-contact",
      "blocks": [
        {
          "type": "hero",
          "heading": "Tenant-scoped public form preview",
          "body": "This preview renders the complete form contract but does not send a request."
        }
      ]
    }
  ],
  "redirects": [
    {
      "from": "/home",
      "to": "/",
      "status": 301
    }
  ],
  "forms": [
    {
      "id": "synthetic-contact",
      "formMappingId": "mapping-synthetic-contact-0001",
      "fieldContractVersion": "synthetic-contact-v1",
      "submitLabel": "Send synthetic message",
      "consent": {
        "name": "consent",
        "label": "I consent to this synthetic submission being processed for validation."
      },
      "honeypot": {
        "name": "companyWebsite",
        "label": "Leave this field blank"
      },
      "fields": [
        {
          "name": "name",
          "label": "Name",
          "type": "text",
          "autocomplete": "name",
          "required": true
        },
        {
          "name": "message",
          "label": "Message",
          "type": "textarea",
          "required": true
        }
      ]
    }
  ]
}
